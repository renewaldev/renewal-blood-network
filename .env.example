# ======================================================================
#  Renewal Blood Network - environment configuration (.env)
#  Copy this file to ".env" and fill in the values.
#  Variable names are case-insensitive; restart the server after changes
#  (settings are loaded once and cached).
# ======================================================================

# ── App ───────────────────────────────────────────────────────────────
# "production" enforces strict startup checks (required secrets, Turnstile on,
# shared rate-limit backend for multiple workers, etc.).
# Use "development" for local work.
APP_ENV=production
HOST=0.0.0.0
PORT=5500
# Number of uvicorn workers. If > 1 in production, RATE_LIMIT_BACKEND must be "mysql".
WORKERS=2

# ── MySQL / MariaDB ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
# Required in production.
DB_USER=
DB_PASSWORD=
DB_NAME=renewal_blood
# Max connections kept in the SQLAlchemy pool (per process).
DB_POOL_SIZE=10

# ── Secrets (each >= 32 bytes, required in production) ────────────────
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PIN_PEPPER: server-side secret mixed into PIN hashes. Changing it later
#             invalidates all existing user PINs.
PIN_PEPPER=
# CSRF_SECRET: HMAC key used to sign CSRF tokens.
CSRF_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────
# Username of the first super admin. Only used on first startup, when the
# "admins" table is empty. 3-64 chars: lowercase letters, digits, . _ @ + -
SUPERADMIN_USERNAME=superadmin
# Initial password of the super admin AND the temporary password given to
# every new admin the super admin creates (10-128 chars). Everyone is forced
# to change it at first login. Anyone who knows it can enter a freshly created
# admin account, so activate new admin accounts promptly. Required in production.
ADMIN_TEMP_PASSWORD=
# Optional legacy: pre-computed super admin password hash. Used for seeding
# only if ADMIN_TEMP_PASSWORD is empty.
ADMIN_PASSWORD_HASH=
# Optional comma-separated CIDR list that may access /admin (e.g. 203.0.113.0/24).
# Empty = allow everyone.
ADMIN_IP_ALLOWLIST=
# Admin session lifetime in hours.
ADMIN_SESSION_TTL_HOURS=8
# Max concurrent scrypt password hashes per process (range 1-8). Each uses ~16 MB.
# Use 2 on small servers; 4 is fine with 4 vCPU / 2 GB+ RAM.
HASH_CONCURRENCY=2

# ── Web / security ────────────────────────────────────────────────────
# Comma-separated list of allowed Origins (scheme + host + port, no trailing slash).
# Used for HTTP CORS checks AND the WebSocket handshake (blocks cross-site
# WebSocket hijacking). It must match the browser address bar exactly.
# Production example:  ALLOWED_ORIGINS=https://example.com
# Local dev example:   ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_ORIGINS=https://example.com
# Marks cookies as Secure (and uses the __Host- prefix). Set to false ONLY for
# local development over plain http.
COOKIE_SECURE=true
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For /
# CF-Connecting-IP headers are trusted (e.g. your Nginx or Cloudflare).
TRUSTED_PROXIES=127.0.0.1/32
# Where rate-limit counters live: "memory" (single worker only) or "mysql"
# (shared across workers; required when WORKERS > 1 in production).
RATE_LIMIT_BACKEND=mysql
# User session lifetime in days.
SESSION_TTL_DAYS=30

# ── Cloudflare Turnstile (bot protection) ─────────────────────────────
# Must be true in production. Set false only for local development.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Sign-In ────────────────────────────────────────────────────
GOOGLE_LOGIN_ENABLED=false
# OAuth client ID from Google Cloud Console (needed when enabled).
GOOGLE_CLIENT_ID=

# ── SMS OTP ───────────────────────────────────────────────────────────
# OTP is currently disabled. A production SMS provider is not implemented yet,
# so OTP_ENABLED=true is rejected in production.
OTP_ENABLED=false
# none = no provider | log = print codes to the server log (development only)
SMS_PROVIDER=none

# ── Phone-number reveal quotas ────────────────────────────────────────
# Limits how many NEW phone numbers a user may reveal (rolling windows).
# Re-viewing a number already revealed never counts against the quota.
# Daily limit (24h) for users with no donor profile or verification level 0.
REVEAL_QUOTA_NEW=5
# Daily limit (24h) for users with verification level >= 1.
REVEAL_QUOTA_VERIFIED=20
# Hourly limit for everyone (stops bursts).
REVEAL_HOURLY_LIMIT=10
# Limit within the first hour after account creation.
REVEAL_NEWACCOUNT_LIMIT=2